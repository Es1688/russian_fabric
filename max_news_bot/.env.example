# Токен бота MAX: выдаёт @masterbot (dev.max.ru) при создании бота.
MAX_BOT_TOKEN=
# chat_id канала MAX (целое число): узнать командой /chatid после того,
# как бот добавлен администратором канала с правом публикации.
MAX_CHANNEL_ID=
# user_id администраторов через запятую (целые числа; НЕ chat_id лички —
# личные сообщения адресуются по user_id, свой user_id подскажет /chatid
# в личном диалоге с ботом). Каждый админ обязан один раз
# написать боту /start — иначе бот не сможет отправлять ему личные сообщения
# (превью рубрик, алерты): в MAX бот не может инициировать диалог сам.
ADMIN_IDS=
# Уровень логирования (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
# Путь к SQLite-базе. Локально можно оставить пустым (дефолт data/max_news_bot.db);
# в Docker задаётся compose-файлом: /app/data/max_news_bot.db.
DATABASE_PATH=

# --- LLM-каналы контура рубрик (ADR-002) ---
# API-ключ OpenRouter (openrouter.ai) — ПЕРВИЧНЫЙ LLM-канал. Только здесь, не в yaml.
OPENROUTER_API_KEY=
# API-ключ Yandex AI Studio (console.yandex.cloud) — РЕЗЕРВНЫЙ LLM-канал
# (Yandex GPT) и генерация изображений YandexART; нужен платный
# billing-аккаунт, бесплатного tier нет. Только здесь, не в yaml.
LLM_API_KEY=
# Переопределение базы URL ПЕРВИЧНОГО канала (дефолт
# https://openrouter.ai/api/v1). Внимание: не указывайте здесь Yandex —
# это молча сделало бы резервный канал первичным.
LLM_BASE_URL=
# Переопределение модели первичного канала (дефолт qwen/qwen3.8-flash).
LLM_MODEL=
# База URL резервного канала (дефолт https://ai.api.cloud.yandex.net/v1).
LLM_FALLBACK_BASE_URL=
# Модель резервного канала в формате gpt://<folder_id>/model
# (дефолт gpt://FOLDER_ID/yandexgpt-5-lite); folder_id — каталог Yandex Cloud.
LLM_FALLBACK_MODEL=
# API-ключ fal.ai (fal.ai) — генерация изображений для рубрик с
# image: generate в rubrics.yaml (модель fal-ai/flux/dev). Обязателен,
# только если такая рубрика включена (иначе запуск падает с fail-fast
# ошибкой). YandexART — зарезервированная заглушка и ключа пока не требует.
FAL_KEY=
# Egress-прокси для иностранных API (ADR-005): СТРОГО socks5h://host:port,
# без логина/пароля (socks5:// отвергается при старте — это DNS-лик на
# RU-резолверы). Пусто (дефолт) = весь трафик напрямую. На VPS — локальный
# вход stelthVPN: socks5h://127.0.0.1:1080 (порт = STELTHVPN_RU_BOT_SOCKS_PORT);
# контейнер при этом обязан работать в network_mode: host (см. infra/).
# Через прокси ходят ТОЛЬКО OpenRouter и fal.ai; MAX, Yandex, RSS и погода — напрямую.
EGRESS_PROXY_URL=

# --- Контур рубрик (единственный publishing-контур, ADR-004) ---
# Dry-run контура рубрик (true/false, дефолт true): посты по сетке уходят
# админам из ADMIN_IDS в личку, боевой канал не затрагивается. При true
# ADMIN_IDS обязателен. Переключение на прод — RUBRICS_DRY_RUN=false.
RUBRICS_DRY_RUN=
# Путь к yaml конфигу рубрик (дефолт max_news_bot/config/rubrics.yaml);
# файл обязателен и валидируется при старте.
RUBRICS_CONFIG_PATH=
